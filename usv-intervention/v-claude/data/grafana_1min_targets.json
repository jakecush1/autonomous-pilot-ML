{
  "maxDataPoints": 50000,
  "targets": [
    {
      "refId": "A",
      "alias": "wind_speed_kn",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "vessel_id:${vid} AND weather.wind.source:truenorth",
      "timeField": "@timestamp",
      "metrics": [
        { "id": "1", "type": "avg", "field": "weather.wind.speed", "settings": { "script": "_value * 1.94384" } }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    },
    {
      "refId": "B",
      "alias": "wind_from_sin",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "vessel_id:${vid} AND weather.wind.source:truenorth",
      "timeField": "@timestamp",
      "metrics": [
        { "id": "1", "type": "avg", "field": "weather.wind.angle", "settings": { "script": "Math.sin(_value)" } }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    },
    {
      "refId": "C",
      "alias": "wind_from_cos",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "vessel_id:${vid} AND weather.wind.source:truenorth",
      "timeField": "@timestamp",
      "metrics": [
        { "id": "1", "type": "avg", "field": "weather.wind.angle", "settings": { "script": "Math.cos(_value)" } }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    },
    {
      "refId": "D",
      "alias": "motor_power",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "(NOT (pob.torq_vs:0 AND pob.torq_cs:0)) AND vessel_id:${vid} AND (pob.torq_cs:<60000)",
      "timeField": "@timestamp",
      "metrics": [
        {
          "id": "1",
          "type": "avg",
          "field": "pob.torq_vs",
          "inlineScript": "_value * doc['pob.torq_cs'].value / 10",
          "settings": { "script": { "inline": "_value * doc['pob.torq_cs'].value / 10" } }
        }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    },
    {
      "refId": "E",
      "alias": "lat",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "(NOT gps_location.lat:0) AND vessel_id:${vid} AND _index:vessel_oor.power.telemetry*",
      "timeField": "@timestamp",
      "metrics": [
        { "id": "1", "type": "avg", "field": "gps_location.lat", "settings": {} }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    },
    {
      "refId": "F",
      "alias": "lon",
      "datasource": { "type": "elasticsearch", "uid": "P31C819B24CF3C3C7" },
      "query": "(NOT gps_location.lon:0) AND vessel_id:${vid} AND _index:vessel_oor.power.telemetry*",
      "timeField": "@timestamp",
      "metrics": [
        { "id": "1", "type": "avg", "field": "gps_location.lon", "settings": {} }
      ],
      "bucketAggs": [
        { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m", "min_doc_count": "0", "trimEdges": "0" } }
      ]
    }
  ]
}
